{:paths ["src"]
 ;; Playwright is the caller's: step-thru reaches the Page by interop only, so
 ;; it never pins a Playwright version on the app that uses it.
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}}
 :aliases {:test {:extra-paths ["test"]
                  :extra-deps {com.microsoft.playwright/playwright {:mvn/version "1.58.0"}
                               io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
                  :main-opts ["-m" "cognitect.test-runner"]}}}
